      "path": "src/tool_domains/personal_workspace.py",
      "symbols": [
        "do_manage_notes",
        "toggle_item"
      ]
    },
    {
      "domain": "memory_tool",
      "path": "src/ai_interaction.py",
      "symbols": [
        "do_manage_memory"
      ]
    },
    {
      "domain": "memory_public_schema",
      "path": "src/tool_schema_definitions.py",
      "symbols": [
        "manage_memory"
      ]
    },
    {
      "domain": "scheduled_digest",
      "path": "src/builtin_actions.py",
      "symbols": [
        "_todo_digest_from_notes",
        "action_todo_digest"
      ]
    },
    {
      "domain": "schedule_contract",
      "path": "src/calendar_capability_service.py",
      "symbols": [
        "build_todo_digest_schedule_plan"
      ]
    },
    {
      "domain": "transaction_evidence",
      "path": "src/tool_transaction_ledger.py",
      "symbols": [
        "ToolTransaction",
        "transactions_from_tool_events"
      ]
    },
    {
      "domain": "claim_gate",
      "path": "src/claim_evidence_gate.py",
      "symbols": [
        "evaluate_response_claims"
      ]
    },
    {
      "domain": "telegram_pre_send_gate",
      "path": "src/telegram_truth_gate.py",
      "symbols": [
        "gate_telegram_reply_text"
      ]
    },
    {
      "domain": "telegram_bridge",
      "path": "plugins/telegram/plugin.py",
      "symbols": [
        "gate_telegram_reply_text"
      ]
    }
  ],
  "privacy_contract": {
    "repo_fixtures": "synthetic_only",
    "forbidden_persisted_fields": [
      "raw_chat",
      "private_todo_text",
      "chat_id",
      "token",
      "owner_identifier",
      "absolute_private_path"
    ],
    "evidence_allowed": [
      "counts",
      "status",
      "content_free_hashes",
      "redacted_refs"
    ]
  },
  "next_frontier": {
