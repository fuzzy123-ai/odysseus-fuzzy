{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odysseus.local/specs/agent-maintenance-verification-receipt.v1.schema.json",
  "title": "Agent Maintenance Verification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "producer",
    "binding",
    "lane",
    "result",
    "strongest_evidence_level",
    "required_checks",
    "checks",
    "passed_checks",
    "failed_checks",
    "skipped_checks",
    "unavailable_checks",
    "not_verified",
    "content_free",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "odysseus.agent_maintenance_verification_receipt.v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "odysseus.scripts.verify"},
        "version": {"const": 1}
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace_state", "head_revision", "dirty_diff_digest"],
          "properties": {
            "workspace_state": {"const": "clean_head"},
            "head_revision": {"$ref": "#/$defs/revision"},
            "dirty_diff_digest": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace_state", "head_revision", "dirty_diff_digest"],
          "properties": {
            "workspace_state": {"const": "dirty_diff"},
            "head_revision": {"$ref": "#/$defs/revision"},
            "dirty_diff_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "lane": {"$ref": "#/$defs/token"},
    "result": {
      "enum": ["passed", "failed", "unavailable", "not_verified"]
    },
    "strongest_evidence_level": {
      "enum": [
        "none",
        "static",
        "fast",
        "full",
        "ui_contract",
        "visual",
        "ui_contract_plus_visual_artifact"
      ]
    },
    "required_checks": {"$ref": "#/$defs/tokenList"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "required", "status", "evidence_level"],
        "properties": {
          "check_id": {"$ref": "#/$defs/token"},
          "required": {"type": "boolean"},
          "status": {
            "enum": ["passed", "failed", "skipped", "unavailable"]
          },
          "evidence_level": {
            "enum": ["static", "fast", "full", "ui_contract", "visual"]
          }
        }
      }
    },
    "passed_checks": {"$ref": "#/$defs/tokenList"},
    "failed_checks": {"$ref": "#/$defs/tokenList"},
    "skipped_checks": {"$ref": "#/$defs/tokenList"},
    "unavailable_checks": {"$ref": "#/$defs/tokenList"},
    "not_verified": {"$ref": "#/$defs/tokenList"},
    "content_free": {"const": true},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$"
    },
    "tokenList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
