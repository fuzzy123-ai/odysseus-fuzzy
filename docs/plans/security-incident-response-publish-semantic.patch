+        "scope_fingerprint": (1, 0), "policy_revision": (1, 0), "idempotency_key": (1, 0), "request_fingerprint": (1, 0),
+        "ttl_seconds": (1, 0), "expires_at": (1, 0), "receipt_ref": (1, 0), "verification_ref": (1, 0),
