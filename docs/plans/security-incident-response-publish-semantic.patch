+
+
+def test_actual_environment_override_attempts_are_rejected_before_dispatch_without_value_leak():
+    for environment in (
+        {"RESTIC_PASSWORD_COMMAND": "cat private-token"}, {"RESTIC_PASSWORD": "private-token"},
