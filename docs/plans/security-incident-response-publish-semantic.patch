+def test_sirp11_packets_are_bounded_non_authorizing_and_secret_safe() -> None:
+    claimed_docs = (
+        ROOT / "docs/plans/security-incident-response-activation-packet.md",
+        ROOT / "docs/runbooks/security-incident-response.md",
