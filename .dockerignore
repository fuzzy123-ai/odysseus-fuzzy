venv/
.venv/
node_modules/
services/node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.env
.env.bak.*
# Secrets: keep plaintext and every transient secrets.env variant out of
# the build context. If an encrypted secrets.env is used, it is mounted
# at runtime — never baked into the image. Mirrored in .gitignore.
secrets.env
secrets.env.*
secrets.env~
.secrets.env.swp
.secrets.env.swo
**/#secrets.env#
!secrets.env.example
/data/
/logs/
.git/
.claude/
.playwright-mcp/
.pytest_cache/
.pytest-tmp*/
.vscode/
.idea/
dev-docs/
docs/
*.md
*.db
*.sqlite
*.sqlite3
/reports/
/research_data/
tasks/
_scratch/
compound.config.json
search_analytics.json
**/search_analytics.json
tests/
api/
*.log
*.error.log
chart.png
timetree*.png
*_signin_page.png
*_calendar_view.png
.gitignore

# Admin-only non-UI readiness routes audit roadmap JSON at runtime. Keep the
# rest of docs excluded, but include the bounded machine-readable plan inputs.
!docs/
docs/*
!docs/plans/
docs/plans/*
!docs/plans/*.json
